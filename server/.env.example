# Public application identity
MOBILEUI_PUBLIC_ORIGIN=http://localhost:3210

# Store production data on a persistent volume.
MOBILEUI_DATABASE_PATH=./data/mobilestarter.db

# Replace every local-development value before production deployment.
MOBILEUI_ADMIN_KEY=replace-with-a-long-random-secret
MOBILEUI_PHONE_PEPPER=replace-with-a-long-random-secret
MOBILEUI_RESET_PEPPER=replace-with-a-long-random-secret

# Optional delivery providers
MOBILEUI_EMAIL_ENDPOINT=
MOBILEUI_EMAIL_API_KEY=
MOBILEUI_SMS_ENDPOINT=
MOBILEUI_SMS_API_KEY=
MOBILEUI_FCM_TENANTS_JSON=
