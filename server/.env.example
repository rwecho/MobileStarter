# Public application identity
AUTH_PUBLIC_ORIGIN=http://localhost:3210
AUTH_DEFAULT_APP_ID=zhongbei

# PostgreSQL connection. DATABASE_URL is also accepted as a fallback.
AUTH_DATABASE_URL=postgresql://zhongbei_auth:change-me@localhost:5432/zhongbei_auth
AUTH_DATABASE_POOL_SIZE=10
# Compose reads this separately. Change both database passwords for production.
ZHONGBEI_AUTH_POSTGRES_PASSWORD=change-me

# Replace every local-development value before production deployment.
MOBILEUI_ADMIN_KEY=replace-with-a-long-random-secret
MOBILEUI_PHONE_PEPPER=replace-with-a-long-random-secret
MOBILEUI_RESET_PEPPER=replace-with-a-long-random-secret

# Optional delivery providers
MOBILEUI_EMAIL_ENDPOINT=
MOBILEUI_EMAIL_API_KEY=
MOBILEUI_SMS_ENDPOINT=
MOBILEUI_SMS_API_KEY=
MOBILEUI_FCM_TENANTS_JSON=

# HMAC secret used to sign entitlement tokens (POST /api/v1/me/entitlement).
# Must be shared with each app-specific backend that verifies Pro status.
ENTITLEMENT_SIGNING_SECRET=
